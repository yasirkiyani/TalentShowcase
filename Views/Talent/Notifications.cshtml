@model NewTalent.Models.NotificationsPageViewModel
@{
    ViewData["Title"] = "Notifications";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>🔔 Notifications</h1>
        @if (Model.UnreadCount > 0)
        {
            <button class="btn btn-sm btn-outline-primary" onclick="markAllAsRead()">Mark All as Read</button>
        }
    </div>

    <!-- Filters -->
    <div class="card mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Filter by Type</label>
                    <select class="form-select" id="typeFilter" onchange="location.href='/Notification/Index?typeFilter=' + this.value + '&showUnreadOnly=' + document.getElementById('unreadCheck').checked">
                        <option value="all">All Types</option>
                        <option value="like" selected="@(Model.TypeFilter == "like")">Likes</option>
                        <option value="comment" selected="@(Model.TypeFilter == "comment")">Comments</option>
                        <option value="message" selected="@(Model.TypeFilter == "message")">Messages</option>
                        <option value="contest" selected="@(Model.TypeFilter == "contest")">Contests</option>
                        <option value="job" selected="@(Model.TypeFilter == "job")">Jobs</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">&nbsp;</label>
                    <div class="form-check mt-2">
                        <input type="checkbox" class="form-check-input" id="unreadCheck" @(Model.ShowUnreadOnly ? "checked" : "") onchange="location.href='/Notification/Index?typeFilter=' + document.getElementById('typeFilter').value + '&showUnreadOnly=' + this.checked">
                        <label class="form-check-label" for="unreadCheck">Show unread only</label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (Model.Notifications.Any())
    {
        <div class="row">
            @foreach (var notification in Model.Notifications)
            {
                <div class="col-md-6 mb-3">
                    <div class="card @(notification.IsRead ? "" : "border-primary")">
                        <div class="card-body">
                            <div class="d-flex align-items-start">
                                <div class="me-3">
                                    <span class="badge @notification.BadgeColor fs-5">
                                        <i class="@notification.IconClass"></i>
                                    </span>
                                </div>
                                <div class="flex-grow-1">
                                    <h5 class="card-title mb-1">@notification.Title</h5>
                                    <p class="card-text mb-2">@notification.Message</p>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <small class="text-muted">@notification.CreatedAgo</small>
                                        <div>
                                            @if (!string.IsNullOrEmpty(notification.Link))
                                            {
                                                <a href="@notification.Link" class="btn btn-sm btn-outline-primary me-2">View</a>
                                            }
                                            @if (!notification.IsRead)
                                            {
                                                <button class="btn btn-sm btn-outline-secondary" onclick="markAsRead(@notification.Id)">Mark as Read</button>
                                            }
                                            <button class="btn btn-sm btn-outline-danger" onclick="deleteNotification(@notification.Id)">Delete</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <h4 class="alert-heading">No Notifications</h4>
            <p>You don't have any notifications yet.</p>
        </div>
    }
</div>

<script>
    function markAsRead(id) {
        fetch('/Notification/MarkAsRead', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: 'id=' + id
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                location.reload();
            }
        });
    }

    function markAllAsRead() {
        fetch('/Notification/MarkAllAsRead', {
            method: 'POST'
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                location.reload();
            }
        });
    }

    function deleteNotification(id) {
        if (confirm('Are you sure you want to delete this notification?')) {
            fetch('/Notification/Delete', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: 'id=' + id
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                }
            });
        }
    }
</script>
