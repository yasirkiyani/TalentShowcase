@model List<NewTalent.Data.Entities.MentorshipSession>
@{
    ViewData["Title"] = "My Mentorship Sessions";
}

<div class="container py-4">
    <h1>My Mentorship Sessions</h1>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            You have no mentorship sessions yet. <a href="/Talent/FindMentors">Find a mentor</a> to get started.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var session in Model)
            {
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">@session.Topic</h5>
                            <p class="card-text">@session.Description</p>
                            <div class="mb-2">
                                <strong>Mentor:</strong> @session.Mentor.Username<br>
                                <strong>Mentee:</strong> @session.Mentee.Username
                            </div>
                            <div class="mb-2">
                                <strong>Scheduled:</strong> @session.ScheduledDate.ToString("MMM dd, yyyy HH:mm")<br>
                                <strong>Duration:</strong> @session.DurationMinutes minutes
                            </div>
                            <div>
                                <span class="badge @(session.Status == "completed" ? "bg-success" : session.Status == "scheduled" ? "bg-primary" : session.Status == "cancelled" ? "bg-danger" : "bg-warning")">@session.Status</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
