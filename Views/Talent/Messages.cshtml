@model NewTalent.Models.InboxViewModel
@{
    ViewData["Title"] = "Messages";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>💬 Messages</h1>
        @if (Model.TotalUnread > 0)
        {
            <span class="badge bg-danger">@Model.TotalUnread unread</span>
        }
    </div>

    @if (Model.Conversations.Any())
    {
        <div class="row">
            @foreach (var conversation in Model.Conversations)
            {
                <div class="col-md-6 mb-3">
                    <div class="card @(conversation.UnreadCount > 0 ? "border-primary" : "")">
                        <div class="card-body">
                            <div class="d-flex align-items-start">
                                <div class="me-3">
                                    @if (conversation.User1Id == ViewBag.CurrentUserId)
                                    {
                                        <img src="@conversation.User2Avatar" alt="@conversation.User2Name" class="rounded-circle" width="48" height="48">
                                    }
                                    else
                                    {
                                        <img src="@conversation.User1Avatar" alt="@conversation.User1Name" class="rounded-circle" width="48" height="48">
                                    }
                                </div>
                                <div class="flex-grow-1">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <h5 class="card-title mb-1">
                                                @(conversation.User1Id == ViewBag.CurrentUserId ? conversation.User2Name : conversation.User1Name)
                                                @if (conversation.UnreadCount > 0)
                                                {
                                                    <span class="badge bg-danger ms-2">@conversation.UnreadCount</span>
                                                }
                                            </h5>
                                            <p class="card-text text-muted small mb-1">@conversation.LastMessagePreview</p>
                                            <small class="text-muted">@conversation.LastMessageAgo</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <a href="#" class="btn btn-sm btn-primary mt-2">Open Conversation</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <h4 class="alert-heading">No Messages Yet</h4>
            <p>Start a conversation with other users to connect!</p>
        </div>
    }
</div>
