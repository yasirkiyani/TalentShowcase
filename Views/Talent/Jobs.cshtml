@model NewTalent.Models.JobBoardViewModel
@{
    ViewData["Title"] = "Job Board";
    var isLoggedIn = Context.Session.GetString("UserEmail") != null;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>💼 Job Board</h1>
        @if (isLoggedIn)
        {
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createJobModal">Post a Job</button>
        }
    </div>

    <!-- Filters -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Search</label>
                    <input type="text" name="searchQuery" class="form-control" value="@Model.SearchQuery" placeholder="Search jobs...">
                </div>
                <div class="col-md-2">
                    <label class="form-label">Category</label>
                    <select name="categoryFilter" class="form-select">
                        <option value="">All Categories</option>
                        @foreach (var cat in Model.Categories)
                        {
                            <option value="@cat" selected="@(Model.CategoryFilter == cat)">@cat</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Job Type</label>
                    <select name="jobTypeFilter" class="form-select">
                        <option value="">All Types</option>
                        @foreach (var type in Model.JobTypes)
                        {
                            <option value="@type" selected="@(Model.JobTypeFilter == type)">@type</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Experience</label>
                    <select name="experienceFilter" class="form-select">
                        <option value="">All Levels</option>
                        @foreach (var exp in Model.ExperienceLevels)
                        {
                            <option value="@exp" selected="@(Model.ExperienceFilter == exp)">@exp</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Remote Only</label>
                    <div class="form-check mt-2">
                        <input type="checkbox" name="showRemoteOnly" class="form-check-input" id="remoteCheck" @(Model.ShowRemoteOnly ? "checked" : "")>
                        <label class="form-check-label" for="remoteCheck">Remote jobs only</label>
                    </div>
                </div>
                <div class="col-md-1">
                    <label class="form-label">&nbsp;</label>
                    <button type="submit" class="btn btn-primary w-100">Filter</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Jobs Grid -->
    <div class="row">
        @foreach (var job in Model.Jobs)
        {
            <div class="col-md-6 mb-4">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <h5 class="card-title">@job.Title</h5>
                                <p class="card-text text-muted mb-2">@job.CompanyName</p>
                                <div class="mb-2">
                                    @if (job.IsRemote)
                                    {
                                        <span class="badge bg-success me-1">Remote</span>
                                    }
                                    <span class="badge bg-info me-1">@job.JobType</span>
                                    <span class="badge bg-secondary">@job.Category</span>
                                </div>
                            </div>
                            <img src="@job.CompanyLogo" alt="@job.CompanyName" class="rounded" width="48" height="48" style="object-fit: cover;">
                        </div>
                        <p class="card-text">@(job.Description.Length > 150 ? job.Description.Substring(0, 150) + "..." : job.Description)</p>
                        <div class="mb-2">
                            <small class="text-muted">
                                <i class="bi bi-geo-alt"></i> @job.Location
                                <span class="ms-3"><i class="bi bi-cash"></i> @job.SalaryRange</span>
                            </small>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <small class="text-muted">@job.PostedAgo</small>
                            <div>
                                <button class="btn btn-sm btn-outline-primary" onclick="viewJobDetails(@job.Id)">Details</button>
                                @if (!job.HasApplied && !job.IsOwner)
                                {
                                    <button class="btn btn-sm btn-primary" onclick="joinJob(@job.Id, '@job.PostedByName')">Join</button>
                                }
                                @if (job.HasApplied)
                                {
                                    <span class="badge bg-success">Applied</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Page navigation">
            <ul class="pagination">
                @if (Model.CurrentPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link" href="/Talent/Jobs?page=@(Model.CurrentPage - 1)">Previous</a>
                    </li>
                }
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                        <a class="page-link" href="/Talent/Jobs?page=@i">@i</a>
                    </li>
                }
                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <li class="page-item">
                        <a class="page-link" href="/Talent/Jobs?page=@(Model.CurrentPage + 1)">Next</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>

<!-- Create Job Modal -->
<div class="modal fade" id="createJobModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Post a Job</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="createJobForm">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Job Title *</label>
                            <input type="text" name="Title" class="form-control" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Company Name *</label>
                            <input type="text" name="CompanyName" class="form-control" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Category *</label>
                            <select name="Category" class="form-select" required>
                                <option value="">Select Category</option>
                                <option value="Music">Music</option>
                                <option value="Dance">Dance</option>
                                <option value="Art">Art</option>
                                <option value="Acting">Acting</option>
                                <option value="Coding">Coding</option>
                                <option value="Writing">Writing</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Job Type *</label>
                            <select name="JobType" class="form-select" required>
                                <option value="">Select Type</option>
                                <option value="Full-time">Full-time</option>
                                <option value="Part-time">Part-time</option>
                                <option value="Contract">Contract</option>
                                <option value="Freelance">Freelance</option>
                                <option value="Internship">Internship</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Location *</label>
                            <input type="text" name="Location" class="form-control" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Salary Range *</label>
                            <input type="text" name="SalaryRange" class="form-control" placeholder="e.g., $50,000 - $70,000" required>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Description *</label>
                            <textarea name="Description" class="form-control" rows="5" required></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Experience Level</label>
                            <select name="ExperienceLevel" class="form-select">
                                <option value="">Any</option>
                                <option value="Entry-level">Entry-level</option>
                                <option value="Mid-level">Mid-level</option>
                                <option value="Senior">Senior</option>
                                <option value="Executive">Executive</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Skills Required</label>
                            <input type="text" name="RequiredSkills" class="form-control" placeholder="e.g., JavaScript, React, Node.js">
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input type="checkbox" name="IsRemote" class="form-check-input" id="remoteJob">
                                <label class="form-check-label" for="remoteJob">Remote Job</label>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" onclick="createJob()" class="btn btn-primary">Post Job</button>
            </div>
        </div>
    </div>
</div>

<!-- Job Details Modal -->
<div class="modal fade" id="jobDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Job Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="jobDetailsContent">
                <!-- Content will be loaded here -->
            </div>
        </div>
    </div>
</div>

<script>
    function createJob() {
        const form = document.getElementById('createJobForm');
        const formData = new FormData(form);

        fetch('/Talent/CreateJob', {
            method: 'POST',
            body: formData
        })
        .then(response => response.text())
        .then(text => {
            try {
                const data = JSON.parse(text);
                if (data.success) {
                    bootstrap.Modal.getInstance(document.getElementById('createJobModal')).hide();
                    alert('Job posted successfully!');
                    form.reset();
                    location.reload();
                } else {
                    alert(data.message || 'Failed to post job');
                }
            } catch (e) {
                console.error('Response is not JSON:', text);
                alert('Server error: ' + text.substring(0, 200));
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('An error occurred: ' + error.message);
        });
    }

    function viewJobDetails(jobId) {
        fetch(`/Talent/JobDetails?id=${jobId}`)
        .then(response => response.text())
        .then(text => {
            try {
                const data = JSON.parse(text);
                if (data.success) {
                    const job = data.job;
                    const html = `
                        <div class="row">
                            <div class="col-md-8">
                                <h4>${job.title}</h4>
                                <p class="text-muted">${job.companyName}</p>
                                <div class="mb-3">
                                    ${job.isRemote ? '<span class="badge bg-success me-1">Remote</span>' : ''}
                                    <span class="badge bg-info me-1">${job.jobType}</span>
                                    <span class="badge bg-secondary">${job.category}</span>
                                </div>
                                <p>${job.description}</p>
                                <div class="mb-3">
                                    <strong>Location:</strong> ${job.location}<br>
                                    <strong>Salary:</strong> ${job.salaryRange}<br>
                                    <strong>Experience:</strong> ${job.experienceLevel || 'Any'}<br>
                                    <strong>Skills:</strong> ${job.requiredSkills || 'Not specified'}
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card">
                                    <div class="card-body">
                                        <h6 class="card-title">Posted By</h6>
                                        <div class="d-flex align-items-center mb-3">
                                            <img src="${job.creatorProfilePicture || 'https://ui-avatars.com/api/?name=' + encodeURIComponent(job.creatorName) + '&background=random'}" 
                                                 class="rounded-circle me-2" width="50" height="50">
                                            <div>
                                                <strong>${job.creatorName}</strong>
                                                <p class="text-muted small mb-0">Posted ${job.postedAgo}</p>
                                            </div>
                                        </div>
                                        ${!job.hasApplied && !job.isOwner ? 
                                            '<button class="btn btn-primary w-100" onclick="joinJob(' + job.id + ', \'' + job.creatorName + '\')">Join This Job</button>' : 
                                            job.hasApplied ? '<span class="badge bg-success">Applied</span>' : ''}
                                    </div>
                                </div>
                            </div>
                        </div>
                    `;
                    document.getElementById('jobDetailsContent').innerHTML = html;
                    const modal = new bootstrap.Modal(document.getElementById('jobDetailsModal'));
                    modal.show();
                } else {
                    alert(data.message || 'Failed to load job details');
                }
            } catch (e) {
                console.error('Response is not JSON:', text);
                alert('Server error: ' + text.substring(0, 200));
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('An error occurred: ' + error.message);
        });
    }

    function joinJob(jobId, creatorName) {
        const userEmail = '@Context.Session.GetString("UserEmail")';
        if (!userEmail) {
            alert('Please login to join jobs');
            window.location.href = '/Talent/Login';
            return;
        }

        const formData = new FormData();
        formData.append('jobId', jobId);

        fetch('/Talent/JoinJob', {
            method: 'POST',
            body: formData
        })
        .then(response => response.text())
        .then(text => {
            try {
                const data = JSON.parse(text);
                if (data.success) {
                    alert(`Thank you for joining. Kindly wait for response from ${creatorName}`);
                    bootstrap.Modal.getInstance(document.getElementById('jobDetailsModal'))?.hide();
                    location.reload();
                } else {
                    alert(data.message || 'Failed to join job');
                }
            } catch (e) {
                console.error('Response is not JSON:', text);
                alert('Server error: ' + text.substring(0, 200));
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('An error occurred: ' + error.message);
        });
    }
</script>
