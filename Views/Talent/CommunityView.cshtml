@section Scripts {
    <script>
        // Handle Join Community functionality
        function handleJoinCommunity() {
            const isLoggedIn = localStorage.getItem('isLoggedIn');
            
            if (isLoggedIn !== 'true') {
                // User is not logged in
                showNotification('Please login to join this community!', 'warning');
                setTimeout(() => {
                    window.location.href = '/Home/Login';
                }, 1500);
                return;
            }
            
            // User is logged in - handle join community
            const joinBtn = document.getElementById('joinCommunityBtn');
            const isJoined = joinBtn.classList.contains('btn-success');
            
            if (isJoined) {
                // Leave community
                joinBtn.classList.remove('btn-success');
                joinBtn.classList.add('btn-primary');
                joinBtn.innerHTML = '<i class="bi bi-plus-circle"></i> Join Community';
                showNotification('You have left the community!', 'info');
                
                // Update member count (simulate)
                updateMemberCount(-1);
            } else {
                // Join community
                joinBtn.classList.remove('btn-primary');
                joinBtn.classList.add('btn-success');
                joinBtn.innerHTML = '<i class="bi bi-check-circle"></i> Joined';
                showNotification('Successfully joined the community!', 'success');
                
                // Update member count (simulate)
                updateMemberCount(1);
            }
        }
        
        // Update member count
        function updateMemberCount(change) {
            const memberBadge = document.querySelector('.badge.bg-primary');
            if (memberBadge) {
                const currentCount = parseFloat(memberBadge.textContent);
                const newCount = currentCount + change;
                
                if (newCount >= 1000) {
                    memberBadge.textContent = (newCount / 1000).toFixed(1) + 'K members';
                } else {
                    memberBadge.textContent = Math.round(newCount) + ' members';
                }
            }
        }
        
        // Check join status on page load
        function checkJoinStatus() {
            const isLoggedIn = localStorage.getItem('isLoggedIn');
            const joinBtn = document.getElementById('joinCommunityBtn');
            
            if (isLoggedIn !== 'true') {
                // User not logged in - show join button
                joinBtn.classList.remove('btn-success');
                joinBtn.classList.add('btn-primary');
                joinBtn.innerHTML = '<i class="bi bi-plus-circle"></i> Join Community';
            } else {
                // User logged in - simulate already joined (you can check from backend)
                const userName = localStorage.getItem('userName');
                if (userName === 'Demo User') {
                    // Demo user is already a member
                    joinBtn.classList.remove('btn-primary');
                    joinBtn.classList.add('btn-success');
                    joinBtn.innerHTML = '<i class="bi bi-check-circle"></i> Joined';
                }
            }
        }
        
        // Simulate audio player
        document.addEventListener('DOMContentLoaded', function() {
            checkLoginStatus();
            checkJoinStatus();
            
            // Audio player simulation
            const playButtons = document.querySelectorAll('.bg-light .btn-primary');
            playButtons.forEach(button => {
                button.addEventListener('click', function() {
                    const progressBar = this.closest('.bg-light').querySelector('.progress-bar');
                    let width = 0;
                    const interval = setInterval(() => {
                        if (width >= 100) {
                            clearInterval(interval);
                            width = 0;
                        } else {
                            width += 2;
                            progressBar.style.width = width + '%';
                        }
                    }, 100);
                });
            });
        });
    </script>
}
