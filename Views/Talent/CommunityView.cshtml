@{
    ViewData["Title"] = "Community View";
}

<!-- Community Header -->
<section class="community-header bg-light py-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-3 text-center">
                <img src="https://picsum.photos/seed/musiclovers/150/150" alt="Community" class="rounded-circle mb-3" width="150" height="150">
                <h3 class="mb-2">Music Lovers</h3>
                <p class="text-muted">All music enthusiasts welcome</p>
                <div class="d-flex justify-content-center gap-2 mb-3">
                    <span class="badge bg-primary">2.5K members</span>
                    <span class="badge bg-success">Very Active</span>
                </div>
                <button class="btn btn-primary w-100" id="joinCommunityBtn" onclick="handleJoinCommunity()">
                    <i class="bi bi-plus-circle"></i> Join Community
                </button>
            </div>
            <div class="col-md-9">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">About This Community</h5>
                        <p class="card-text">
                            Welcome to Music Lovers! This is a vibrant community for musicians, singers, composers, and music enthusiasts of all levels. Share your musical journey, get feedback, collaborate with other artists, and discover new talents.
                        </p>
                        <div class="row mt-4">
                            <div class="col-md-3">
                                <div class="text-center">
                                    <h4 class="text-primary">2.5K</h4>
                                    <p class="text-muted mb-0">Members</p>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="text-center">
                                    <h4 class="text-success">156</h4>
                                    <p class="text-muted mb-0">Online Now</p>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="text-center">
                                    <h4 class="text-warning">89</h4>
                                    <p class="text-muted mb-0">Posts Today</p>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="text-center">
                                    <h4 class="text-info">12</h4>
                                    <p class="text-muted mb-0">Events</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

