@model NewTalent.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<!-- Login Section -->
<section class="login-section py-5">
    <div class="container">
        <div class="row justify-content-center">

            <!-- Login Form -->
            <div class="col-lg-5 col-md-7">
                <div class="card shadow-lg">
                    <div class="card-body p-5">

                        <div class="text-center mb-4">
                            <i class="bi bi-stars text-primary display-4"></i>
                            <h3 class="mt-3">Welcome Back</h3>
                            <p class="text-muted">Sign in to your TalentHub account</p>
                        </div>

                        <!-- ASP.NET CORE FORM -->
                        <form asp-controller="Talent"
                              asp-action="Login"
                              method="post">

                            <!-- Validation Summary -->
                            <div asp-validation-summary="ModelOnly"
                                 class="text-danger mb-3">
                            </div>

                            <!-- Email -->
                            <div class="mb-3">

                                <label asp-for="Email" class="form-label"></label>

                                <div class="input-group">

                                    <span class="input-group-text">
                                        <i class="bi bi-envelope"></i>
                                    </span>

                                    <input asp-for="Email"
                                           class="form-control"
                                           placeholder="Enter your email" />

                                </div>

                                <span asp-validation-for="Email"
                                      class="text-danger">
                                </span>

                            </div>

                            <!-- Password -->
                            <div class="mb-3">

                                <label asp-for="Password" class="form-label"></label>

                                <div class="input-group">

                                    <span class="input-group-text">
                                        <i class="bi bi-lock"></i>
                                    </span>

                                    <input asp-for="Password"
                                           class="form-control"
                                           id="password"
                                           placeholder="Enter your password" />

                                    <button class="btn btn-outline-secondary"
                                            type="button"
                                            onclick="togglePassword()">

                                        <i class="bi bi-eye"
                                           id="passwordToggle"></i>

                                    </button>

                                </div>

                                <span asp-validation-for="Password"
                                      class="text-danger">
                                </span>

                            </div>

                            <!-- Remember Me -->
                            <div class="d-flex justify-content-between align-items-center mb-4">

                                <div class="form-check">

                                    <input asp-for="RememberMe"
                                           class="form-check-input" />

                                    <label asp-for="RememberMe"
                                           class="form-check-label">
                                    </label>

                                </div>

                                <a href="#"
                                       class="text-decoration-none">
                                    Forgot password?
                                </a>

                            </div>

                            <!-- Submit -->
                            <button type="submit"
                                    class="btn btn-primary btn-lg w-100 mb-3">

                                <i class="bi bi-box-arrow-in-right"></i>
                                Sign In

                            </button>

                            <!-- Register -->
                            <div class="text-center">

                                <p class="mb-0">
                                    Don't have an account?

                                    <a asp-controller="Talent"
                                           asp-action="Register"
                                           class="text-decoration-none">

                                        Sign up here

                                    </a>
                                </p>

                            </div>

                        </form>

                        <hr class="my-4">

                        <!-- Social Login -->
                        <div class="social-login">

                            <p class="text-center text-muted mb-3">
                                Or continue with
                            </p>

                            <div class="d-grid gap-2">

                                <button type="button"
                                        class="btn btn-outline-primary">

                                    <i class="bi bi-google"></i>
                                    Continue with Google

                                </button>

                                <button type="button"
                                        class="btn btn-outline-primary">

                                    <i class="bi bi-facebook"></i>
                                    Continue with Facebook

                                </button>

                                <button type="button"
                                        class="btn btn-outline-primary">

                                    <i class="bi bi-twitter"></i>
                                    Continue with Twitter

                                </button>

                            </div>

                        </div>

                    </div>
                </div>

                <!-- Security Info -->
                <div class="card mt-4">

                    <div class="card-body">

                        <h6 class="card-title">
                            <i class="bi bi-shield-check text-success"></i>
                            Secure Login
                        </h6>

                        <p class="card-text small text-muted mb-0">
                            Your login is protected with industry-standard encryption.
                            We never share your personal information with third parties.
                        </p>

                    </div>

                </div>

            </div>

            <!-- Features Column -->
            <div class="col-lg-5 col-md-5">

                <div class="features-section">

                    <h4 class="mb-4">Why Join TalentHub?</h4>

                    <div class="feature-item mb-4">

                        <div class="d-flex align-items-start">

                            <div class="feature-icon text-primary me-3">
                                <i class="bi bi-play-circle display-6"></i>
                            </div>

                            <div>
                                <h5 class="mb-2">Showcase Your Talent</h5>

                                <p class="text-muted">
                                    Upload videos and share your unique skills
                                    with a global audience of talent enthusiasts.
                                </p>
                            </div>

                        </div>

                    </div>

                    <div class="feature-item mb-4">

                        <div class="d-flex align-items-start">

                            <div class="feature-icon text-success me-3">
                                <i class="bi bi-people display-6"></i>
                            </div>

                            <div>
                                <h5 class="mb-2">Join Communities</h5>

                                <p class="text-muted">
                                    Connect with like-minded individuals,
                                    join interest-based groups,
                                    and collaborate on projects.
                                </p>
                            </div>

                        </div>

                    </div>

                    <div class="feature-item mb-4">

                        <div class="d-flex align-items-start">

                            <div class="feature-icon text-warning me-3">
                                <i class="bi bi-trophy display-6"></i>
                            </div>

                            <div>
                                <h5 class="mb-2">Win Contests</h5>

                                <p class="text-muted">
                                    Participate in talent competitions,
                                    win prizes,
                                    and gain recognition for your skills.
                                </p>
                            </div>

                        </div>

                    </div>

                    <div class="feature-item mb-4">

                        <div class="d-flex align-items-start">

                            <div class="feature-icon text-info me-3">
                                <i class="bi bi-person-workspace display-6"></i>
                            </div>

                            <div>
                                <h5 class="mb-2">Get Mentorship</h5>

                                <p class="text-muted">
                                    Learn from experienced professionals
                                    and accelerate your growth
                                    with personalized guidance.
                                </p>
                            </div>

                        </div>

                    </div>

                    <div class="feature-item">

                        <div class="d-flex align-items-start">

                            <div class="feature-icon text-danger me-3">
                                <i class="bi bi-briefcase display-6"></i>
                            </div>

                            <div>
                                <h5 class="mb-2">Find Opportunities</h5>

                                <p class="text-muted">
                                    Discover job opportunities,
                                    freelance projects,
                                    and connect with industry recruiters.
                                </p>
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>
    </div>
</section>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        function togglePassword() {

            const passwordInput =
                document.getElementById('password');

            const passwordToggle =
                document.getElementById('passwordToggle');

            if (passwordInput.type === 'password') {

                passwordInput.type = 'text';

                passwordToggle.className =
                    'bi bi-eye-slash';

            }
            else {

                passwordInput.type = 'password';

                passwordToggle.className =
                    'bi bi-eye';

            }
        }

    </script>

}