@model NewTalent.Models.JobBoardViewModel
@{
    ViewData["Title"] = "My Applications";
}

<div class="container py-4">
    <h1 class="mb-4">My Job Applications</h1>

    @if (Model.MyApplications.Any())
    {
        <div class="row">
            @foreach (var application in Model.MyApplications)
            {
                <div class="col-md-6 mb-4">
                    <div class="card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h5 class="card-title">@application.JobTitle</h5>
                                    <p class="card-text text-muted mb-2">@application.CompanyName</p>
                                </div>
                                <span class="badge @application.StatusBadgeColor">@application.Status</span>
                            </div>
                            <p class="card-text"><small class="text-muted">Applied @application.AppliedAgo</small></p>
                            <a href="#" class="btn btn-sm btn-outline-primary">View Job</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <h4 class="alert-heading">No Applications Yet</h4>
            <p>You haven't applied to any jobs yet. Browse the job board to find opportunities!</p>
            <a href="/Talent/Jobs" class="btn btn-primary">Browse Jobs</a>
        </div>
    }
</div>
