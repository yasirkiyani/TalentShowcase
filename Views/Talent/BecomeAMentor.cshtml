@model NewTalent.Data.Entities.MentorshipProfile
@{
    ViewData["Title"] = "Become a Mentor";
}

<!-- HERO SECTION -->
<section class="hero-section text-white">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 fade-in">
                <h1 class="display-4 fw-bold">Become a Mentor</h1>
                <p class="lead">Share your expertise and help others grow their talents. Create your mentor profile today.</p>
            </div>
            <div class="col-lg-6 text-center hero-image">
                <img src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?w=800&h=600&fit=crop" class="img-fluid rounded-4 shadow-lg" alt="Become a Mentor" />
            </div>
        </div>
    </div>
</section>

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h4 class="mb-0">Create Mentor Profile</h4>
                </div>
                <div class="card-body">
                    <form asp-action="BecomeAMentor" method="post">
                        <div class="mb-3">
                            <label asp-for="Title" class="form-label">Professional Title</label>
                            <input asp-for="Title" class="form-control" placeholder="e.g., Professional Music Producer, Award-winning Choreographer" required />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Bio" class="form-label">Bio</label>
                            <textarea asp-for="Bio" class="form-control" rows="4" placeholder="Tell us about yourself and your mentoring style" required></textarea>
                            <span asp-validation-for="Bio" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Experience" class="form-label">Years of Experience</label>
                                <input asp-for="Experience" class="form-control" placeholder="e.g., 5 years" />
                                <span asp-validation-for="Experience" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="HourlyRate" class="form-label">Hourly Rate ($)</label>
                                <input asp-for="HourlyRate" type="number" class="form-control" min="0" step="0.01" value="0" />
                                <span asp-validation-for="HourlyRate" class="text-danger"></span>
                                <small class="text-muted">Enter 0 for free mentoring</small>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ExpertiseAreas" class="form-label">Expertise Areas (comma-separated)</label>
                            <input asp-for="ExpertiseAreas" class="form-control" placeholder="e.g., Vocal Coaching, Songwriting, Music Production" />
                            <span asp-validation-for="ExpertiseAreas" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Qualifications" class="form-label">Qualifications</label>
                            <textarea asp-for="Qualifications" class="form-control" rows="2" placeholder="Degrees, certifications, awards"></textarea>
                            <span asp-validation-for="Qualifications" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="PortfolioUrl" class="form-label">Portfolio URL</label>
                                <input asp-for="PortfolioUrl" type="url" class="form-control" placeholder="https://..." />
                                <span asp-validation-for="PortfolioUrl" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="WebsiteUrl" class="form-label">Website URL</label>
                                <input asp-for="WebsiteUrl" type="url" class="form-control" placeholder="https://..." />
                                <span asp-validation-for="WebsiteUrl" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="LinkedInUrl" class="form-label">LinkedIn URL</label>
                            <input asp-for="LinkedInUrl" type="url" class="form-control" placeholder="https://linkedin.com/..." />
                            <span asp-validation-for="LinkedInUrl" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="MaxMentees" class="form-label">Max Mentees</label>
                                <input asp-for="MaxMentees" type="number" class="form-control" min="1" value="5" required />
                                <span asp-validation-for="MaxMentees" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="SessionFormat" class="form-label">Session Format</label>
                                <select asp-for="SessionFormat" class="form-select" required>
                                    <option value="online">Online</option>
                                    <option value="in_person">In Person</option>
                                    <option value="hybrid">Hybrid</option>
                                </select>
                                <span asp-validation-for="SessionFormat" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="AvailabilitySchedule" class="form-label">Availability Schedule</label>
                            <input asp-for="AvailabilitySchedule" class="form-control" placeholder="e.g., Weekdays 9AM-5PM" />
                            <span asp-validation-for="AvailabilitySchedule" class="text-danger"></span>
                        </div>

                        <div class="form-check mb-3">
                            <input asp-for="IsAvailable" class="form-check-input" type="checkbox" />
                            <label asp-for="IsAvailable" class="form-check-label">Available for new mentees</label>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">Create Profile</button>
                            <a href="/Talent/MentorCollabs" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
