@model NewTalent.Data.Entities.Collaboration
@{
    ViewData["Title"] = "Create Collaboration";
}

<!-- HERO SECTION -->
<section class="hero-section text-white">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 fade-in">
                <h1 class="display-4 fw-bold">Create Collaboration</h1>
                <p class="lead">Start a new collaboration project and find talented partners to work with.</p>
            </div>
            <div class="col-lg-6 text-center hero-image">
                <img src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?w=800&h=600&fit=crop" class="img-fluid rounded-4 shadow-lg" alt="Create Collaboration" />
            </div>
        </div>
    </div>
</section>

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h4 class="mb-0">Create New Collaboration</h4>
                </div>
                <div class="card-body">
                    <form asp-action="CreateCollaboration" method="post">
                        <div class="mb-3">
                            <label asp-for="Title" class="form-label">Project Title</label>
                            <input asp-for="Title" class="form-control" required />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="4" required></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Category" class="form-label">Category</label>
                                <select asp-for="Category" class="form-select" required>
                                    <option value="">Select Category</option>
                                    <option value="Music">Music</option>
                                    <option value="Dance">Dance</option>
                                    <option value="Art">Art</option>
                                    <option value="Acting">Acting</option>
                                    <option value="Coding">Coding</option>
                                    <option value="Writing">Writing</option>
                                    <option value="Comedy">Comedy</option>
                                    <option value="Other">Other</option>
                                </select>
                                <span asp-validation-for="Category" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="ProjectType" class="form-label">Project Type</label>
                                <select asp-for="ProjectType" class="form-select" required>
                                    <option value="">Select Type</option>
                                    <option value="joint_performance">Joint Performance</option>
                                    <option value="contest">Contest Entry</option>
                                    <option value="creative_project">Creative Project</option>
                                    <option value="other">Other</option>
                                </select>
                                <span asp-validation-for="ProjectType" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="RequiredSkills" class="form-label">Required Skills (comma-separated)</label>
                            <input asp-for="RequiredSkills" class="form-control" placeholder="e.g., Singing, Guitar, Video Editing" required />
                            <span asp-validation-for="RequiredSkills" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="MaxParticipants" class="form-label">Max Participants</label>
                                <input asp-for="MaxParticipants" type="number" class="form-control" min="2" value="2" required />
                                <span asp-validation-for="MaxParticipants" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Deadline" class="form-label">Deadline</label>
                                <input asp-for="Deadline" type="date" class="form-control" required />
                                <span asp-validation-for="Deadline" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ProjectTimeline" class="form-label">Project Timeline</label>
                            <input asp-for="ProjectTimeline" class="form-control" placeholder="e.g., 2 weeks, 1 month" />
                            <span asp-validation-for="ProjectTimeline" class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">Create Collaboration</button>
                            <a href="/Talent/Collaborations" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
