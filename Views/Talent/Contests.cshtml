@model List<NewTalent.Data.Entities.Contest>
@{
    ViewData["Title"] = "Contests";
    var isLoggedIn = Context.Session.GetString("UserEmail") != null;
}

<!-- HERO SECTION -->
<section class="hero-section text-white">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 fade-in">
                <h1 class="display-4 fw-bold">Compete & Win Prizes</h1>
                <p class="lead">Participate in exciting talent contests, showcase your skills, and win amazing prizes. Join competitions across various categories and get recognized for your talent.</p>
                <div class="mt-4">
                    @if (isLoggedIn)
                    {
                        <button class="btn btn-primary me-2" data-bs-toggle="modal" data-bs-target="#createContestModal">
                            <i class="bi bi-trophy"></i> Create Contest
                        </button>
                    }
                    <a href="#contestsSection" class="btn btn-outline-primary">View Contests</a>
                </div>
            </div>
            <div class="col-lg-6 text-center hero-image">
                <img src="https://images.unsplash.com/photo-1542744173-8e7e53415bb0?w=800&h=600&fit=crop" class="img-fluid rounded-4 shadow-lg" alt="Contests" />
            </div>
        </div>
    </div>
</section>

<div class="container py-4" id="contestsSection">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>🏆 Talent Contests</h1>
        @if (isLoggedIn)
        {
            <div class="btn-group">
                <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createContestModal">Create Contest</button>
            </div>
        }
    </div>

    <!-- Filters -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Category</label>
                    <select name="category" class="form-select">
                        <option value="">All Categories</option>
                        <option value="Music">Music</option>
                        <option value="Dance">Dance</option>
                        <option value="Art">Art</option>
                        <option value="Acting">Acting</option>
                        <option value="Coding">Coding</option>
                        <option value="Writing">Writing</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Status</label>
                    <select name="status" class="form-select">
                        <option value="">All Status</option>
                        <option value="active">Active</option>
                        <option value="upcoming">Upcoming</option>
                        <option value="completed">Completed</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Skill Level</label>
                    <select name="skillLevel" class="form-select">
                        <option value="">All Levels</option>
                        <option value="beginner">Beginner</option>
                        <option value="intermediate">Intermediate</option>
                        <option value="advanced">Advanced</option>
                        <option value="all">All</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">Filter</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Contests Grid -->
    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            No contests found matching your criteria.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var contest in Model)
            {
                <div class="col-12">
                    <div class="card @(contest.IsFeatured ? "border-primary" : "")">
                        @if (contest.IsFeatured)
                        {
                            <div class="card-header bg-primary text-white">
                                <small>⭐ Featured Contest</small>
                            </div>
                        }
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-4">
                                    <img src="@(string.IsNullOrEmpty(contest.ImageUrl) ? "https://via.placeholder.com/400x200" : contest.ImageUrl)" 
                                         alt="@contest.Title" class="card-img-top mb-3" style="max-height: 200px; object-fit: cover; width: 100%;">
                                </div>
                                <div class="col-md-8">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <span class="badge bg-secondary">@contest.Category</span>
                                        <span class="badge @(contest.Status == "active" ? "bg-success" : contest.Status == "upcoming" ? "bg-info" : "bg-secondary")">@contest.Status</span>
                                    </div>
                                    <h4 class="card-title">@contest.Title</h4>
                                    <p class="card-text">@contest.Description</p>
                                    <div class="mb-2">
                                        <small class="text-muted">
                                            <strong>Prize:</strong> @contest.PrizeAmount<br>
                                            <strong>Participants:</strong> @contest.CurrentParticipants / @contest.MaxParticipants<br>
                                            <strong>Ends:</strong> @contest.EndDate.ToString("MMM dd, yyyy")
                                        </small>
                                    </div>
                                    <div class="d-flex gap-2">
                                        <button onclick="joinContest(@contest.Id)" class="btn btn-sm btn-primary">Join Contest</button>
                                        <button onclick="viewContestDetails(@contest.Id)" class="btn btn-sm btn-outline-primary">Details</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Create Contest Modal -->
<div class="modal fade" id="createContestModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Create New Contest</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="createContestForm">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Title *</label>
                            <input type="text" name="Title" class="form-control" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Category *</label>
                            <select name="Category" class="form-select" required>
                                <option value="Music">Music</option>
                                <option value="Dance">Dance</option>
                                <option value="Art">Art</option>
                                <option value="Acting">Acting</option>
                                <option value="Coding">Coding</option>
                                <option value="Writing">Writing</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Description *</label>
                            <textarea name="Description" class="form-control" rows="3" required></textarea>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Prize Amount</label>
                            <input type="text" name="PrizeAmount" class="form-control" placeholder="$1000">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Max Participants</label>
                            <input type="number" name="MaxParticipants" class="form-control" value="100">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Skill Level</label>
                            <select name="SkillLevel" class="form-select">
                                <option value="beginner">Beginner</option>
                                <option value="intermediate">Intermediate</option>
                                <option value="advanced">Advanced</option>
                                <option value="all">All Levels</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Start Date</label>
                            <input type="date" name="StartDate" class="form-control" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">End Date</label>
                            <input type="date" name="EndDate" class="form-control" required>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Contest Image</label>
                            <input type="file" name="ImageFile" class="form-control" accept="image/*">
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" onclick="createContest()" class="btn btn-primary">Create Contest</button>
            </div>
        </div>
    </div>
</div>

<!-- Contest Details Modal -->
<div class="modal fade" id="contestDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Contest Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="contestDetailsContent">
                <!-- Content will be loaded here -->
            </div>
        </div>
    </div>
</div>

<script>
    function createContest() {
        const form = document.getElementById('createContestForm');
        const formData = new FormData(form);

        fetch('/Talent/CreateContest', {
            method: 'POST',
            body: formData
        })
        .then(response => response.text())
        .then(text => {
            try {
                const data = JSON.parse(text);
                if (data.success) {
                    bootstrap.Modal.getInstance(document.getElementById('createContestModal')).hide();
                    alert('Contest created successfully!');
                    form.reset();
                    location.reload();
                } else {
                    alert(data.message || 'Failed to create contest');
                }
            } catch (e) {
                console.error('Response is not JSON:', text);
                alert('Server error: ' + text.substring(0, 200));
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('An error occurred: ' + error.message);
        });
    }

    function joinContest(contestId) {
        // Check if user is logged in
        const userEmail = '@Context.Session.GetString("UserEmail")';
        if (!userEmail) {
            alert('Please login to join contests');
            window.location.href = '/Talent/Login';
            return;
        }

        // Direct join without entry form
        const formData = new FormData();
        formData.append('contestId', contestId);

        fetch('/Talent/JoinContest', {
            method: 'POST',
            body: formData
        })
        .then(response => response.text())
        .then(text => {
            try {
                const data = JSON.parse(text);
                if (data.success) {
                    alert('Successfully joined contest!');
                    location.reload();
                } else {
                    alert(data.message || 'Failed to join contest');
                }
            } catch (e) {
                console.error('Response is not JSON:', text);
                alert('Server error: ' + text.substring(0, 200));
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('An error occurred: ' + error.message);
        });
    }

    function submitContestEntry() {
        // This function is no longer needed since we removed the modal
    }

    function viewContestDetails(contestId) {
        fetch(`/Talent/ContestDetails?id=${contestId}`)
        .then(response => response.text())
        .then(text => {
            try {
                const data = JSON.parse(text);
                if (data.success) {
                    const contest = data.contest;
                    const participants = data.participants || [];
                    
                    let html = `
                        <div class="row">
                            <div class="col-md-4">
                                <img src="${contest.imageUrl || 'https://via.placeholder.com/400x200'}" class="img-fluid rounded mb-3">
                            </div>
                            <div class="col-md-8">
                                <h4>${contest.title}</h4>
                                <p>${contest.description}</p>
                                <div class="mb-2">
                                    <strong>Category:</strong> ${contest.category}<br>
                                    <strong>Prize:</strong> ${contest.prizeAmount}<br>
                                    <strong>Skill Level:</strong> ${contest.skillLevel}<br>
                                    <strong>Participants:</strong> ${contest.currentParticipants} / ${contest.maxParticipants}<br>
                                    <strong>Start Date:</strong> ${new Date(contest.startDate).toLocaleDateString()}<br>
                                    <strong>End Date:</strong> ${new Date(contest.endDate).toLocaleDateString()}<br>
                                    <strong>Status:</strong> ${contest.status}<br>
                                    <strong>Created By:</strong> ${contest.createdBy}
                                </div>
                            </div>
                        </div>
                        <hr>
                        <h5>Participants (${participants.length})</h5>
                    `;
                    
                    if (participants.length > 0) {
                        html += '<div class="row">';
                        participants.forEach(p => {
                            html += `
                                <div class="col-md-6 mb-3">
                                    <div class="card">
                                        <div class="card-body">
                                            <div class="d-flex align-items-center">
                                                <img src="${p.profilePicture || 'https://ui-avatars.com/api/?name=' + encodeURIComponent(p.username) + '&background=random'}" 
                                                     class="rounded-circle me-3" width="50" height="50">
                                                <div>
                                                    <h6 class="mb-0">${p.username}</h6>
                                                    <small class="text-muted">${p.title}</small>
                                                </div>
                                            </div>
                                            <p class="mt-2 mb-0 small">${p.description}</p>
                                        </div>
                                    </div>
                                </div>
                            `;
                        });
                        html += '</div>';
                    } else {
                        html += '<p class="text-muted">No participants yet.</p>';
                    }
                    
                    document.getElementById('contestDetailsContent').innerHTML = html;
                    const modal = new bootstrap.Modal(document.getElementById('contestDetailsModal'));
                    modal.show();
                } else {
                    alert(data.message || 'Failed to load contest details');
                }
            } catch (e) {
                console.error('Response is not JSON:', text);
                alert('Server error: ' + text.substring(0, 200));
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('An error occurred: ' + error.message);
        });
    }
</script>
