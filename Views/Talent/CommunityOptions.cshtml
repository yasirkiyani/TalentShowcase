@{
    ViewData["Title"] = "Community Options";
}

<!-- Community Options Header -->
<section class="bg-light py-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-4 text-center">
                <img src="https://picsum.photos/seed/musiclovers/120/120" alt="Community" class="rounded-circle mb-3" width="120" height="120">
                <h3 class="mb-2">Music Lovers</h3>
                <p class="text-muted">Community Settings</p>
                <div class="d-flex justify-content-center gap-2 mb-3">
                    <span class="badge bg-primary">2.5K members</span>
                    <span class="badge bg-success">Admin</span>
                </div>
            </div>
            <div class="col-md-8">
                <h2 class="mb-4">Community Management</h2>
                <p class="text-muted">
                    Manage your community settings, members, posts, and events all in one place.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- Options Content -->
<section class="py-5">
    <div class="container">
        <div class="row">
            <!-- Sidebar -->
            <div class="col-md-3">
                <div class="card">
                    <div class="card-body p-0">
                        <nav class="nav nav-pills nav-fill flex-column">
                            <a class="nav-link active" href="#general" data-bs-toggle="pill">
                                <i class="bi bi-gear"></i> General
                            </a>
                            <a class="nav-link" href="#members" data-bs-toggle="pill">
                                <i class="bi bi-people"></i> Members
                            </a>
                            <a class="nav-link" href="#posts" data-bs-toggle="pill">
                                <i class="bi bi-file-text"></i> Posts
                            </a>
                            <a class="nav-link" href="#events" data-bs-toggle="pill">
                                <i class="bi bi-calendar-event"></i> Events
                            </a>
                            <a class="nav-link" href="#rules" data-bs-toggle="pill">
                                <i class="bi bi-shield-check"></i> Rules
                            </a>
                            <a class="nav-link" href="#analytics" data-bs-toggle="pill">
                                <i class="bi bi-graph-up"></i> Analytics
                            </a>
                        </nav>
                    </div>
                </div>
            </div>

            <!-- Main Content -->
            <div class="col-md-9">
                <div class="tab-content">
                    <!-- General Settings -->
                    <div class="tab-pane fade show active" id="general">
                        <div class="card">
                            <div class="card-body">
                                <h5 class="card-title mb-4">General Settings</h5>
                                
                                <form>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label for="communityName" class="form-label">Community Name</label>
                                            <input type="text" class="form-control" id="communityName" value="Music Lovers">
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label for="communityCategory" class="form-label">Category</label>
                                            <select class="form-select" id="communityCategory">
                                                <option selected>Music</option>
                                                <option>Dance</option>
                                                <option>Art</option>
                                                <option>Acting</option>
                                                <option>Programming</option>
                                            </select>
                                        </div>
                                    </div>
                                    
                                    <div class="mb-3">
                                        <label for="communityDescription" class="form-label">Description</label>
                                        <textarea class="form-control" id="communityDescription" rows="4">Welcome to Music Lovers! This is a vibrant community for musicians, singers, composers, and music enthusiasts of all levels.</textarea>
                                    </div>
                                    
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label for="communityPrivacy" class="form-label">Privacy</label>
                                            <select class="form-select" id="communityPrivacy">
                                                <option selected>Public</option>
                                                <option>Private</option>
                                                <option>Semi-Private</option>
                                            </select>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label for="communityJoinType" class="form-label">Join Type</label>
                                            <select class="form-select" id="communityJoinType">
                                                <option selected>Anyone can join</option>
                                                <option>Approval required</option>
                                                <option>Invite only</option>
                                            </select>
                                        </div>
                                    </div>
                                    
                                    <div class="mb-3">
                                        <label for="communityTags" class="form-label">Tags</label>
                                        <input type="text" class="form-control" id="communityTags" value="music, singing, composition, collaboration">
                                        <small class="text-muted">Separate tags with commas</small>
                                    </div>
                                    
                                    <div class="form-check form-switch mb-3">
                                        <input class="form-check-input" type="checkbox" id="allowPosts" checked>
                                        <label class="form-check-label" for="allowPosts">
                                            Allow members to post
                                        </label>
                                    </div>
                                    
                                    <div class="form-check form-switch mb-3">
                                        <input class="form-check-input" type="checkbox" id="allowEvents" checked>
                                        <label class="form-check-label" for="allowEvents">
                                            Allow members to create events
                                        </label>
                                    </div>
                                    
                                    <div class="form-check form-switch mb-4">
                                        <input class="form-check-input" type="checkbox" id="moderatePosts" checked>
                                        <label class="form-check-label" for="moderatePosts">
                                            Moderate posts before publishing
                                        </label>
                                    </div>
                                    
                                    <div class="d-flex gap-2">
                                        <button type="submit" class="btn btn-primary">
                                            <i class="bi bi-check-circle"></i> Save Changes
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary">
                                            <i class="bi bi-arrow-clockwise"></i> Reset
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>

                    <!-- Members Management -->
                    <div class="tab-pane fade" id="members">
                        <div class="card">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center mb-4">
                                    <h5 class="card-title">Members Management</h5>
                                    <button class="btn btn-primary btn-sm">
                                        <i class="bi bi-person-plus"></i> Invite Members
                                    </button>
                                </div>
                                
                                <div class="table-responsive">
                                    <table class="table">
                                        <thead>
                                            <tr>
                                                <th>Member</th>
                                                <th>Role</th>
                                                <th>Joined</th>
                                                <th>Status</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        <img src="https://picsum.photos/seed/admin/40/40" alt="Admin" class="rounded-circle me-2" width="40" height="40">
                                                        <div>
                                                            <div class="fw-bold">John Doe</div>
                                                            <small class="text-muted">john@example.com</small>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td><span class="badge bg-danger">Admin</span></td>
                                                <td>Dec 1, 2024</td>
                                                <td><span class="badge bg-success">Active</span></td>
                                                <td>
                                                    <div class="btn-group btn-group-sm">
                                                        <button class="btn btn-outline-primary"><i class="bi bi-envelope"></i></button>
                                                        <button class="btn btn-outline-secondary"><i class="bi bi-three-dots"></i></button>
                                                    </div>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        <img src="https://picsum.photos/seed/mod1/40/40" alt="Moderator" class="rounded-circle me-2" width="40" height="40">
                                                        <div>
                                                            <div class="fw-bold">Sarah Johnson</div>
                                                            <small class="text-muted">sarah@example.com</small>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td><span class="badge bg-warning">Moderator</span></td>
                                                <td>Dec 3, 2024</td>
                                                <td><span class="badge bg-success">Active</span></td>
                                                <td>
                                                    <div class="btn-group btn-group-sm">
                                                        <button class="btn btn-outline-primary"><i class="bi bi-envelope"></i></button>
                                                        <button class="btn btn-outline-secondary"><i class="bi bi-three-dots"></i></button>
                                                    </div>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        <img src="https://picsum.photos/seed/member1/40/40" alt="Member" class="rounded-circle me-2" width="40" height="40">
                                                        <div>
                                                            <div class="fw-bold">Mike Chen</div>
                                                            <small class="text-muted">mike@example.com</small>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td><span class="badge bg-primary">Member</span></td>
                                                <td>Dec 5, 2024</td>
                                                <td><span class="badge bg-success">Active</span></td>
                                                <td>
                                                    <div class="btn-group btn-group-sm">
                                                        <button class="btn btn-outline-primary"><i class="bi bi-envelope"></i></button>
                                                        <button class="btn btn-outline-warning"><i class="bi bi-person-gear"></i></button>
                                                        <button class="btn btn-outline-danger"><i class="bi bi-person-x"></i></button>
                                                    </div>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                                
                                <div class="d-flex justify-content-between align-items-center mt-3">
                                    <small class="text-muted">Showing 3 of 2,543 members</small>
                                    <nav>
                                        <ul class="pagination pagination-sm mb-0">
                                            <li class="page-item disabled"><a class="page-link" href="#">Previous</a></li>
                                            <li class="page-item active"><a class="page-link" href="#">1</a></li>
                                            <li class="page-item"><a class="page-link" href="#">2</a></li>
                                            <li class="page-item"><a class="page-link" href="#">3</a></li>
                                            <li class="page-item"><a class="page-link" href="#">Next</a></li>
                                        </ul>
                                    </nav>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Posts Management -->
                    <div class="tab-pane fade" id="posts">
                        <div class="card">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center mb-4">
                                    <h5 class="card-title">Posts Management</h5>
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-secondary">All Posts</button>
                                        <button class="btn btn-outline-secondary">Pending</button>
                                        <button class="btn btn-outline-secondary">Reported</button>
                                    </div>
                                </div>
                                
                                <div class="list-group">
                                    <div class="list-group-item">
                                        <div class="d-flex align-items-start">
                                            <img src="https://picsum.photos/seed/user1/40/40" alt="User" class="rounded-circle me-3" width="40" height="40">
                                            <div class="flex-grow-1">
                                                <div class="d-flex justify-content-between align-items-start">
                                                    <div>
                                                        <h6 class="mb-1">Sarah Johnson</h6>
                                                        <small class="text-muted">2 hours ago</small>
                                                    </div>
                                                    <span class="badge bg-success">Approved</span>
                                                </div>
                                                <p class="mt-2 mb-2">Just finished recording my new song! Would love to get some feedback...</p>
                                                <div class="d-flex gap-2">
                                                    <button class="btn btn-sm btn-outline-primary"><i class="bi bi-eye"></i> View</button>
                                                    <button class="btn btn-sm btn-outline-warning"><i class="bi bi-pencil"></i> Edit</button>
                                                    <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Delete</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div class="list-group-item">
                                        <div class="d-flex align-items-start">
                                            <img src="https://picsum.photos/seed/user2/40/40" alt="User" class="rounded-circle me-3" width="40" height="40">
                                            <div class="flex-grow-1">
                                                <div class="d-flex justify-content-between align-items-start">
                                                    <div>
                                                        <h6 class="mb-1">Mike Chen</h6>
                                                        <small class="text-muted">5 hours ago</small>
                                                    </div>
                                                    <span class="badge bg-warning">Pending</span>
                                                </div>
                                                <p class="mt-2 mb-2">Looking for guitarists to collaborate on a jazz project!</p>
                                                <div class="d-flex gap-2">
                                                    <button class="btn btn-sm btn-success"><i class="bi bi-check"></i> Approve</button>
                                                    <button class="btn btn-sm btn-danger"><i class="bi bi-x"></i> Reject</button>
                                                    <button class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye"></i> View</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Events Management -->
                    <div class="tab-pane fade" id="events">
                        <div class="card">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center mb-4">
                                    <h5 class="card-title">Events Management</h5>
                                    <button class="btn btn-primary btn-sm">
                                        <i class="bi bi-plus-circle"></i> Create Event
                                    </button>
                                </div>
                                
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <div class="card">
                                            <div class="card-body">
                                                <div class="d-flex justify-content-between align-items-start mb-2">
                                                    <h6 class="card-title">Virtual Jam Session</h6>
                                                    <span class="badge bg-success">Active</span>
                                                </div>
                                                <p class="card-text small text-muted">Dec 15, 2024 • 7:00 PM • Online</p>
                                                <p class="card-text">Join us for an evening of collaborative music making!</p>
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <small class="text-muted">45 attending</small>
                                                    <div class="btn-group btn-group-sm">
                                                        <button class="btn btn-outline-primary"><i class="bi bi-pencil"></i></button>
                                                        <button class="btn btn-outline-danger"><i class="bi bi-trash"></i></button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div class="col-md-6 mb-3">
                                        <div class="card">
                                            <div class="card-body">
                                                <div class="d-flex justify-content-between align-items-start mb-2">
                                                    <h6 class="card-title">Songwriting Workshop</h6>
                                                    <span class="badge bg-primary">Upcoming</span>
                                                </div>
                                                <p class="card-text small text-muted">Dec 18, 2024 • 3:00 PM • Online</p>
                                                <p class="card-text">Learn techniques for writing compelling songs.</p>
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <small class="text-muted">28 attending</small>
                                                    <div class="btn-group btn-group-sm">
                                                        <button class="btn btn-outline-primary"><i class="bi bi-pencil"></i></button>
                                                        <button class="btn btn-outline-danger"><i class="bi bi-trash"></i></button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Rules Management -->
                    <div class="tab-pane fade" id="rules">
                        <div class="card">
                            <div class="card-body">
                                <h5 class="card-title mb-4">Community Rules</h5>
                                
                                <div class="mb-4">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <h6>Current Rules</h6>
                                        <button class="btn btn-primary btn-sm">
                                            <i class="bi bi-plus"></i> Add Rule
                                        </button>
                                    </div>
                                    
                                    <div class="list-group">
                                        <div class="list-group-item">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <div>
                                                    <h6 class="mb-1">Be respectful to all members</h6>
                                                    <small class="text-muted">Maintain a positive and supportive environment</small>
                                                </div>
                                                <div class="btn-group btn-group-sm">
                                                    <button class="btn btn-outline-primary"><i class="bi bi-pencil"></i></button>
                                                    <button class="btn btn-outline-danger"><i class="bi bi-trash"></i></button>
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <div class="list-group-item">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <div>
                                                    <h6 class="mb-1">Share original content only</h6>
                                                    <small class="text-muted">Post only your own work or properly credited content</small>
                                                </div>
                                                <div class="btn-group btn-group-sm">
                                                    <button class="btn btn-outline-primary"><i class="bi bi-pencil"></i></button>
                                                    <button class="btn btn-outline-danger"><i class="bi bi-trash"></i></button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Analytics -->
                    <div class="tab-pane fade" id="analytics">
                        <div class="card">
                            <div class="card-body">
                                <h5 class="card-title mb-4">Community Analytics</h5>
                                
                                <div class="row mb-4">
                                    <div class="col-md-3">
                                        <div class="card text-center">
                                            <div class="card-body">
                                                <h3 class="text-primary">2,543</h3>
                                                <p class="card-text">Total Members</p>
                                                <small class="text-success"><i class="bi bi-arrow-up"></i> 12% this month</small>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="card text-center">
                                            <div class="card-body">
                                                <h3 class="text-success">156</h3>
                                                <p class="card-text">Active Today</p>
                                                <small class="text-success"><i class="bi bi-arrow-up"></i> 8% this week</small>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="card text-center">
                                            <div class="card-body">
                                                <h3 class="text-warning">89</h3>
                                                <p class="card-text">Posts Today</p>
                                                <small class="text-muted"><i class="bi bi-dash"></i> Same as yesterday</small>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="card text-center">
                                            <div class="card-body">
                                                <h3 class="text-info">4.8</h3>
                                                <p class="card-text">Engagement Rate</p>
                                                <small class="text-success"><i class="bi bi-arrow-up"></i> 0.3 this week</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <div class="card">
                                            <div class="card-body" style="position: relative; height: 250px;">
                                                <h6 class="card-title">Member Growth</h6>
                                                <canvas id="memberGrowthChart"></canvas>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <div class="card">
                                            <div class="card-body" style="position: relative; height: 250px;">
                                                <h6 class="card-title">Activity Overview</h6>
                                                <canvas id="activityChart"></canvas>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            checkLoginStatus();
            
            // Initialize Charts
            const memberGrowthCtx = document.getElementById('memberGrowthChart');
            const activityCtx = document.getElementById('activityChart');
            
            if (memberGrowthCtx) {
                new Chart(memberGrowthCtx, {
                    type: 'line',
                    data: {
                        labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'],
                        datasets: [{
                            label: 'Members',
                            data: [1800, 1950, 2100, 2250, 2400, 2543],
                            borderColor: '#667eea',
                            backgroundColor: 'rgba(102, 126, 234, 0.1)',
                            tension: 0.4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                display: false
                            }
                        }
                    }
                });
            }
            
            if (activityCtx) {
                new Chart(activityCtx, {
                    type: 'bar',
                    data: {
                        labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
                        datasets: [{
                            label: 'Posts',
                            data: [65, 78, 90, 81, 89, 95, 89],
                            backgroundColor: '#667eea'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                display: false
                            }
                        }
                    }
                });
            }
        });
    </script>
}
