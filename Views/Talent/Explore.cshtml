@model NewTalent.Models.ExploreViewModel
@{
    ViewData["Title"] = "Explore Talents";
    var isLoggedIn = Context.Session.GetString("UserEmail") != null;
}

<!-- HERO SECTION -->
<section class="hero-section text-white">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 fade-in">
                <h1 class="display-4 fw-bold">Discover Amazing Talents</h1>
                <p class="lead">Explore diverse talents from around the world and find inspiration for your own creative journey. Connect with artists, musicians, dancers, and creators who share their passion.</p>
                <div class="mt-4">
                    <a href="/Talent/Upload" class="btn btn-primary me-2">Share Your Talent</a>
                    <a href="#contentSection" class="btn btn-outline-primary">Start Exploring</a>
                </div>
            </div>
            <div class="col-lg-6 text-center hero-image">
                <img src="https://images.unsplash.com/photo-1516450360452-9312f5e86fc7?w=800&h=600&fit=crop" class="img-fluid rounded-4 shadow-lg" alt="Explore Talents" />
            </div>
        </div>
    </div>
</section>

<!-- Content Section -->
<section class="content-section py-5" id="contentSection">
    <div class="container">
        <!-- Results Count -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h5 class="mb-0">
                <span id="resultsCount">@Model.TotalResults</span> Talents Found
            </h5>
            <div class="btn-group" role="group">
                <button type="button" class="btn btn-outline-primary btn-sm active" onclick="setViewMode('grid')">
                    <i class="bi bi-grid-3x3-gap"></i> Grid
                </button>
                <button type="button" class="btn btn-outline-primary btn-sm" onclick="setViewMode('list')">
                    <i class="bi bi-list"></i> List
                </button>
            </div>
        </div>

        <!-- Content Grid -->
        <div class="row g-4" id="contentGrid">
            @foreach (var video in Model.Videos)
            {
                <div class="col-md-6 col-lg-4 content-item">
                    <div class="card video-card h-100">
                        <div class="position-relative">
                            <video class="card-img-top" poster="@video.ThumbnailUrl" style="max-height: 200px; cursor: pointer;" onclick="openVideoModal(@video.Id, '@video.VideoUrl', '@video.Title', '@video.Description', '@video.ArtistName', '@(string.IsNullOrEmpty(video.ArtistProfilePicture) ? "https://via.placeholder.com/40" : video.ArtistProfilePicture)', @video.LikesCount, '@video.UploadedAgo')">
                                <source src="@video.VideoUrl" type="video/mp4">
                                Your browser does not support the video tag.
                            </video>
                            <div class="position-absolute top-0 end-0 m-2">
                                <span class="badge bg-dark">@video.Duration</span>
                            </div>
                            <div class="position-absolute bottom-0 start-0 m-2">
                                <span class="badge bg-primary">@video.Category</span>
                            </div>
                            <div class="position-absolute top-50 start-50 translate-middle">
                                <i class="bi bi-play-circle-fill text-white display-1" style="opacity: 0.8;"></i>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="d-flex align-items-start mb-2">
                                <img src="@(string.IsNullOrEmpty(video.ArtistProfilePicture) ? "https://via.placeholder.com/40" : video.ArtistProfilePicture)"
                                     alt="@video.ArtistName" class="rounded-circle me-2" width="40" height="40">
                                <div class="flex-grow-1">
                                    <h5 class="card-title mb-1">@video.Title</h5>
                                    <p class="text-muted small mb-2">@video.ArtistName</p>
                                </div>
                            </div>
                            <p class="card-text small text-muted">@video.Description</p>

                            <!-- Instagram-style action buttons -->
                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <div class="d-flex gap-3">
                                    <button class="btn btn-link p-0 @(video.IsLikedByCurrentUser ? "text-danger" : "text-dark")" onclick="handleAction(event, 'like', @video.Id)">
                                        <i class="bi bi-heart fs-5"></i>
                                    </button>
                                    <button class="btn btn-link p-0 text-dark" onclick="handleAction(event, 'comment', @video.Id)">
                                        <i class="bi bi-chat fs-5"></i>
                                    </button>
                                    <button class="btn btn-link p-0 text-dark" onclick="handleAction(event, 'share', @video.Id)">
                                        <i class="bi bi-send fs-5"></i>
                                    </button>
                                    <button class="btn btn-link p-0 text-warning" onclick="openRatingModal(@video.Id)">
                                        <i class="bi bi-star fs-5"></i>
                                    </button>
                                </div>
                                <button class="btn btn-link p-0 @(video.IsSavedByCurrentUser ? "text-warning" : "text-dark")">
                                    <i class="bi bi-bookmark fs-5"></i>
                                </button>
                            </div>

                            <!-- Engagement counts -->
                            <div class="mt-2">
                                <strong>@video.LikesCount likes</strong>
                                <span class="ms-3">@video.CommentsCount comments</span>
                                <span class="ms-3">@video.SharesCount shares</span>
                            </div>

                            <!-- Rating display -->
                            <div class="mt-2">
                                <span class="text-warning">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= Math.Round(video.AverageRating))
                                        {
                                            <i class="bi bi-star-fill"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-star"></i>
                                        }
                                    }
                                </span>
                                <span class="text-muted small ms-1">(@video.TotalRatings ratings)</span>
                            </div>

                            <!-- Liked by section -->
                            @if (video.LikesCount > 0)
                            {
                                <div class="mt-2">
                                    <small class="text-muted">
                                        Liked by @video.LikesCount users
                                    </small>
                                </div>
                            }

                            <!-- Timestamp -->
                            <div class="text-muted small mt-1">
                                @video.UploadedAgo
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Load More -->
        <div class="text-center mt-5">
            <button class="btn btn-primary btn-lg" onclick="loadMore()">
                <i class="bi bi-arrow-clockwise"></i> Load More
            </button>
        </div>
    </div>
</section>

<!-- Rating Modal -->
<div class="modal fade" id="ratingModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Rate This Video</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="ratingVideoId" />
                <input type="hidden" id="ratingStars" value="5" />
                
                <div class="text-center mb-4">
                    <h6>How would you rate this performance?</h6>
                    <div class="star-rating fs-2 text-warning cursor-pointer">
                        <i class="bi bi-star-fill" id="star1" data-rating="1" onclick="handleStarClick(this)"></i>
                        <i class="bi bi-star-fill" id="star2" data-rating="2" onclick="handleStarClick(this)"></i>
                        <i class="bi bi-star-fill" id="star3" data-rating="3" onclick="handleStarClick(this)"></i>
                        <i class="bi bi-star-fill" id="star4" data-rating="4" onclick="handleStarClick(this)"></i>
                        <i class="bi bi-star-fill" id="star5" data-rating="5" onclick="handleStarClick(this)"></i>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="ratingReview" class="form-label">Add a review (optional)</label>
                    <textarea class="form-control" id="ratingReview" rows="3" placeholder="Share your thoughts about this performance..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="submitRating()">Submit Rating</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentViewMode = 'grid';
        let isLoading = false;
        let currentPage = 1;

        // Scroll to filters
        function scrollToFilters() {
            document.getElementById('filtersSection').scrollIntoView({ behavior: 'smooth' });
        }

        // Toggle view mode
        function toggleView() {
            setViewMode(currentViewMode === 'grid' ? 'list' : 'grid');
        }

        // Set view mode
        function setViewMode(mode) {
            currentViewMode = mode;
            const grid = document.getElementById('contentGrid');
            const viewIcon = document.getElementById('viewIcon');
            
            if (mode === 'list') {
                grid.classList.remove('row');
                grid.classList.add('list-view');
                viewIcon.className = 'bi bi-list';
            } else {
                grid.classList.add('row');
                grid.classList.remove('list-view');
                viewIcon.className = 'bi bi-grid-3x3-gap';
            }
            
            // Update button states
            document.querySelectorAll('.btn-group .btn').forEach(btn => {
                btn.classList.remove('active');
            });
            event.target.classList.add('active');
        }

        // Apply filters
        function applyFilters() {
            showLoader();
            
            // Get filter values
            const filters = {
                category: document.getElementById('categoryFilter').value,
                skillLevel: document.getElementById('skillLevelFilter').value,
                videoType: document.getElementById('videoTypeFilter').value,
                location: document.getElementById('locationFilter').value,
                quality: document.getElementById('qualityFilter').value,
                sortBy: document.getElementById('sortBy').value,
                dateRange: document.getElementById('dateRange').value,
                search: document.getElementById('searchInput').value,
                tags: document.getElementById('tagsFilter').value
            };
            
            // Build query string
            const queryString = new URLSearchParams(filters).toString();
            
            // Redirect with filters
            window.location.href = '/Talent/Explore?' + queryString;
        }

        // Reset filters
        function resetFilters() {
            document.getElementById('filterForm').reset();
            document.getElementById('activeFilters').style.display = 'none';
            document.getElementById('filterTags').innerHTML = '';
            updateResultsCount(2456); // Reset to original count
            showNotification('Filters reset', 'info');
        }

        // Update active filters display
        function updateActiveFilters(filters) {
            const activeFiltersDiv = document.getElementById('activeFilters');
            const filterTagsDiv = document.getElementById('filterTags');
            
            const tags = [];
            
            if (filters.category) {
                tags.push(`<span class="badge bg-primary me-2">${filters.category}</span>`);
            }
            if (filters.skillLevel) {
                tags.push(`<span class="badge bg-success me-2">${filters.skillLevel}</span>`);
            }
            if (filters.sortBy) {
                tags.push(`<span class="badge bg-warning me-2">${filters.sortBy}</span>`);
            }
            if (filters.dateRange) {
                tags.push(`<span class="badge bg-info me-2">${filters.dateRange}</span>`);
            }
            
            if (tags.length > 0) {
                activeFiltersDiv.style.display = 'block';
                filterTagsDiv.innerHTML = tags.join('');
            } else {
                activeFiltersDiv.style.display = 'none';
            }
        }

        // Update results count
        function updateResultsCount(count) {
            document.getElementById('resultsCount').textContent = count.toLocaleString();
        }

        // Load more content
        function loadMore() {
            if (isLoading) return;
            
            isLoading = true;
            currentPage++;
            const button = event.target;
            button.disabled = true;
            button.innerHTML = '<i class="bi bi-arrow-clockwise spin"></i> Loading...';
            
            // Get current filter values
            const filters = {
                page: currentPage,
                category: document.getElementById('categoryFilter').value,
                skillLevel: document.getElementById('skillLevelFilter').value,
                videoType: document.getElementById('videoTypeFilter').value,
                location: document.getElementById('locationFilter').value,
                quality: document.getElementById('qualityFilter').value,
                sortBy: document.getElementById('sortBy').value,
                dateRange: document.getElementById('dateRange').value,
                search: document.getElementById('searchInput').value,
                tags: document.getElementById('tagsFilter').value
            };
            
            // Build query string
            const queryString = new URLSearchParams(filters).toString();
            
            // Fetch real videos from server
            fetch('/Talent/LoadMoreVideos?' + queryString)
                .then(response => response.json())
                .then(data => {
                    if (data.success && data.videos.length > 0) {
                        const grid = document.getElementById('contentGrid');
                        const newItems = generateVideoCards(data.videos);
                        grid.insertAdjacentHTML('beforeend', newItems);
                        
                        // Update results count
                        const currentCount = parseInt(document.getElementById('resultsCount').textContent.replace(/,/g, ''));
                        document.getElementById('resultsCount').textContent = (currentCount + data.videos.length).toLocaleString();
                        
                        button.disabled = false;
                        button.innerHTML = '<i class="bi bi-arrow-clockwise"></i> Load More';
                        isLoading = false;
                        
                        showNotification('More videos loaded!', 'success');
                    } else {
                        button.disabled = true;
                        button.innerHTML = 'No more videos';
                        button.classList.remove('btn-primary');
                        button.classList.add('btn-secondary');
                        showNotification('No more videos to load', 'info');
                    }
                })
                .catch(error => {
                    console.error('Error loading videos:', error);
                    button.disabled = false;
                    button.innerHTML = '<i class="bi bi-arrow-clockwise"></i> Load More';
                    isLoading = false;
                    showNotification('Failed to load videos', 'danger');
                });
        }

        // Generate video cards from server data
        function generateVideoCards(videos) {
            let html = '';
            videos.forEach(video => {
                const uploadedAgo = getTimeAgo(new Date(video.uploadedAt));
                const artistPic = video.artistProfilePicture || 'https://ui-avatars.com/api/?name=' + encodeURIComponent(video.artistName) + '&background=random';
                const thumbnail = video.thumbnailUrl || 'https://via.placeholder.com/400x225';
                
                html += `
                    <div class="col-md-6 col-lg-4 content-item fade-in">
                        <div class="card video-card h-100">
                            <div class="position-relative">
                                <video class="card-img-top" poster="${thumbnail}" style="max-height: 200px; cursor: pointer;" onclick="openVideoModal(${video.id}, '${video.videoUrl}', '${video.title.replace(/'/g, "\\'")}', '${video.description.replace(/'/g, "\\'")}', '${video.artistName}', '${artistPic}', ${video.likesCount}, '${uploadedAgo}')">
                                    <source src="${video.videoUrl}" type="video/mp4">
                                    Your browser does not support the video tag.
                                </video>
                                <div class="position-absolute top-0 end-0 m-2">
                                    <span class="badge bg-dark">${video.duration || '0:00'}</span>
                                </div>
                                <div class="position-absolute bottom-0 start-0 m-2">
                                    <span class="badge bg-primary">${video.category}</span>
                                </div>
                                <div class="position-absolute top-50 start-50 translate-middle">
                                    <i class="bi bi-play-circle-fill text-white display-1" style="opacity: 0.8;"></i>
                                </div>
                            </div>
                            <div class="card-body">
                                <div class="d-flex align-items-start mb-2">
                                    <img src="${artistPic}" alt="${video.artistName}" class="rounded-circle me-2" width="40" height="40">
                                    <div class="flex-grow-1">
                                        <h5 class="card-title mb-1">${video.title}</h5>
                                        <p class="text-muted small mb-2">${video.artistName}</p>
                                    </div>
                                </div>
                                <p class="card-text small text-muted">${video.description}</p>

                                <!-- Instagram-style action buttons -->
                                <div class="d-flex justify-content-between align-items-center mt-3">
                                    <div class="d-flex gap-3">
                                        <button class="btn btn-link p-0 ${video.isLikedByCurrentUser ? "text-danger" : "text-dark"}" onclick="handleAction(event, 'like', ${video.id})">
                                            <i class="bi bi-heart fs-5"></i>
                                        </button>
                                        <button class="btn btn-link p-0 text-dark" onclick="handleAction(event, 'comment', ${video.id})">
                                            <i class="bi bi-chat fs-5"></i>
                                        </button>
                                        <button class="btn btn-link p-0 text-dark" onclick="handleAction(event, 'share', ${video.id})">
                                            <i class="bi bi-send fs-5"></i>
                                        </button>
                                        <button class="btn btn-link p-0 text-warning" onclick="openRatingModal(${video.id})">
                                            <i class="bi bi-star fs-5"></i>
                                        </button>
                                    </div>
                                    <button class="btn btn-link p-0 ${video.isSavedByCurrentUser ? "text-warning" : "text-dark"}">
                                        <i class="bi bi-bookmark fs-5"></i>
                                    </button>
                                </div>

                                <!-- Engagement counts -->
                                <div class="mt-2">
                                    <strong>${video.likesCount} likes</strong>
                                    <span class="ms-3">${video.commentsCount} comments</span>
                                    <span class="ms-3">${video.sharesCount} shares</span>
                                </div>

                                <!-- Rating display -->
                                <div class="mt-2">
                                    <span class="text-warning">
                                        ${generateStars(video.averageRating)}
                                    </span>
                                    <span class="text-muted small ms-1">(${video.totalRatings} ratings)</span>
                                </div>

                                <!-- Liked by section -->
                                ${video.likesCount > 0 ? `
                                    <div class="mt-2">
                                        <small class="text-muted">
                                            Liked by ${video.likesCount} users
                                        </small>
                                    </div>
                                ` : ''}

                                <!-- Timestamp -->
                                <div class="text-muted small mt-1">
                                    ${uploadedAgo}
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            });
            return html;
        }

        // Generate star rating HTML
        function generateStars(rating) {
            let html = '';
            const roundedRating = Math.round(rating);
            for (let i = 1; i <= 5; i++) {
                if (i <= roundedRating) {
                    html += '<i class="bi bi-star-fill"></i>';
                } else {
                    html += '<i class="bi bi-star"></i>';
                }
            }
            return html;
        }

        // Get time ago string
        function getTimeAgo(date) {
            const now = new Date();
            const diff = now - date;
            const seconds = Math.floor(diff / 1000);
            const minutes = Math.floor(seconds / 60);
            const hours = Math.floor(minutes / 60);
            const days = Math.floor(hours / 24);
            
            if (days > 30) return Math.floor(days / 30) + ' month(s) ago';
            if (days > 1) return days + ' day(s) ago';
            if (hours > 1) return hours + ' hour(s) ago';
            if (minutes > 1) return minutes + ' minute(s) ago';
            return 'Just now';
        }

        // Add CSS for list view
        const style = document.createElement('style');
        style.textContent = `
            .list-view .content-item {
                width: 100%;
            }

            .list-view .video-card {
                display: flex;
                flex-direction: row;
                max-height: 200px;
            }

            .list-view .video-card .card-img-top {
                width: 300px;
                height: 200px;
                object-fit: cover;
            }

            .list-view .video-card .card-body {
                flex: 1;
                display: flex;
                flex-direction: column;
            }

            .spin {
                animation: spin 1s linear infinite;
            }

            @@keyframes spin {
                from { transform: rotate(0deg); }
                to { transform: rotate(360deg); }
            }
        `;
        document.head.appendChild(style);

        // Handle like/comment/share actions
        function handleAction(event, action, videoId) {
            event.preventDefault();

            // Check if user is logged in
            @if (!isLoggedIn)
            {
                <text>
                alert('Please login or register first to perform this action');
                window.location.href = '/Talent/Login';
                return;
                </text>
            }

            // Perform the action
            if (action === 'like') {
                fetch('/Talent/LikeVideo', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: 'videoId=' + videoId
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert(data.message);
                        location.reload();
                    } else {
                        alert(data.message);
                    }
                })
                .catch(error => console.error('Error:', error));
            } else if (action === 'comment') {
                var comment = prompt('Enter your comment:');
                if (comment) {
                    fetch('/Talent/CommentVideo', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                        },
                        body: 'videoId=' + videoId + '&content=' + encodeURIComponent(comment)
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            alert(data.message);
                            location.reload();
                        } else {
                            alert(data.message);
                        }
                    })
                    .catch(error => console.error('Error:', error));
                }
            } else if (action === 'share') {
                fetch('/Talent/ShareVideo', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: 'videoId=' + videoId
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert(data.message);
                    } else {
                        alert(data.message);
                    }
                })
                .catch(error => console.error('Error:', error));
            }
        }

        // Open video modal when clicking on video
        function openVideoModal(videoId, videoUrl, title, description, artistName, artistPic, likesCount, uploadedAgo) {
            const modal = new bootstrap.Modal(document.getElementById('videoModal'));
            document.getElementById('modalVideo').src = videoUrl;
            document.getElementById('modalArtistName').textContent = artistName;
            document.getElementById('modalArtistUsername').textContent = '@@' + artistName;
            document.getElementById('modalArtistPic').src = artistPic || 'https://via.placeholder.com/40';
            document.getElementById('modalDescription').textContent = description;
            document.getElementById('modalLikesCount').textContent = likesCount;
            document.getElementById('modalTimestamp').textContent = uploadedAgo;

            // Clear comments container
            const commentsContainer = document.getElementById('modalComments');
            commentsContainer.innerHTML = '<p class="text-muted small">Loading comments...</p>';

            // Fetch comments via AJAX
            fetch('/Talent/GetVideoComments?videoId=' + videoId)
                .then(response => response.json())
                .then(data => {
                    commentsContainer.innerHTML = '';
                    if (data && data.length > 0) {
                        data.forEach(function(comment) {
                            const commentHtml = `
                                <div class="d-flex mb-3">
                                    <img src="${comment.userAvatar || 'https://via.placeholder.com/32'}"
                                         alt="${comment.userName}" class="rounded-circle me-2" width="32" height="32">
                                    <div class="flex-grow-1">
                                        <div class="small">
                                            <strong>${comment.userName}</strong>
                                            <span class="text-muted ms-1">${comment.createdAgo}</span>
                                        </div>
                                        <div class="small text-muted">${comment.content}</div>
                                    </div>
                                </div>
                            `;
                            commentsContainer.innerHTML += commentHtml;
                        });
                    } else {
                        commentsContainer.innerHTML = '<p class="text-muted small">No comments yet. Be the first to comment!</p>';
                    }
                })
                .catch(error => {
                    commentsContainer.innerHTML = '<p class="text-muted small">Failed to load comments.</p>';
                });

            // Set up modal action buttons
            document.getElementById('modalLikeBtn').onclick = function(e) {
                handleAction(e, 'like', videoId);
            };
            document.getElementById('modalCommentBtn').onclick = function(e) {
                handleAction(e, 'comment', videoId);
            };
            document.getElementById('modalShareBtn').onclick = function(e) {
                handleAction(e, 'share', videoId);
            };

            modal.show();
        }

        // Open rating modal
        function openRatingModal(videoId) {
            @if (!isLoggedIn)
            {
                <text>
                alert('Please login or register first to rate videos');
                window.location.href = '/Talent/Login';
                return;
                </text>
            }

            const ratingModal = new bootstrap.Modal(document.getElementById('ratingModal'));
            document.getElementById('ratingVideoId').value = videoId;
            document.getElementById('ratingStars').value = 5;
            document.getElementById('ratingReview').value = '';
            updateStarDisplay(5);
            ratingModal.show();
        }

        // Update star display in rating modal
        function updateStarDisplay(rating) {
            for (let i = 1; i <= 5; i++) {
                const star = document.getElementById(`star${i}`);
                if (i <= rating) {
                    star.classList.remove('bi-star');
                    star.classList.add('bi-star-fill');
                } else {
                    star.classList.remove('bi-star-fill');
                    star.classList.add('bi-star');
                }
            }
        }

        // Handle star click
        function handleStarClick(star) {
            const rating = parseInt(star.dataset.rating);
            document.getElementById('ratingStars').value = rating;
            updateStarDisplay(rating);
        }

        // Submit rating
        function submitRating() {
            const videoId = document.getElementById('ratingVideoId').value;
            const stars = document.getElementById('ratingStars').value;
            const review = document.getElementById('ratingReview').value;

            fetch('/Talent/RateVideo', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: `videoId=${videoId}&stars=${stars}&review=${encodeURIComponent(review)}`
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert(data.message);
                    bootstrap.Modal.getInstance(document.getElementById('ratingModal')).hide();
                    location.reload();
                } else {
                    alert(data.message);
                }
            })
            .catch(error => console.error('Error:', error));
        }
    </script>
}
