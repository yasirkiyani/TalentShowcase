@model List<NewTalent.Data.Entities.Collaboration>
@{
    ViewData["Title"] = "My Collaborations";
}

<div class="container py-4">
    <h1>My Collaborations</h1>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            You're not part of any collaborations yet. <a href="/Talent/Collaborations">Browse collaborations</a> to find opportunities or <a href="/Talent/Collaborations">create your own</a>.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var collab in Model)
            {
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge bg-primary">@collab.Category</span>
                                <span class="badge @(collab.Status == "open" ? "bg-success" : collab.Status == "in_progress" ? "bg-warning" : "bg-danger")">@collab.Status</span>
                            </div>
                            <h5 class="card-title">@collab.Title</h5>
                            <p class="card-text small text-truncate">@collab.Description</p>
                            <div class="mb-2">
                                <small class="text-muted">
                                    <strong>Creator:</strong> @collab.Creator.Username<br>
                                    <strong>Participants:</strong> @collab.Participants.Count / @collab.MaxParticipants<br>
                                    <strong>Deadline:</strong> @collab.Deadline.ToString("MMM dd, yyyy")
                                </small>
                            </div>
                            <a href="#" class="btn btn-sm btn-primary">View Details</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
